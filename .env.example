# Frontend (Vite dev server)
PORT=5173
BASE_PATH=/

# Backend (API server)
API_PORT=8080

# CORS
CORS_ORIGIN=http://localhost:5173

# Node
NODE_ENV=development

# Access protection (REQUIRED in production)
# The whole dashboard (UI + API + WebSocket) is protected by HTTP Basic auth.
# Without DASHBOARD_PASSWORD the production server refuses to start.
# Generate a strong secret:  openssl rand -base64 24
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Used to sign the session cookie; falls back to DASHBOARD_PASSWORD.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=
# Optional: separate key to encrypt the server-side Yandex token vault.
# If unset, falls back to SESSION_SECRET or DASHBOARD_PASSWORD.
# Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Where runtime data (settings.json, uploaded images) is stored.
# Defaults to ./data relative to the API server working directory.
# DATA_DIR=/var/lib/yandex-dashboard

# Production single-process mode only: path to the built frontend.
# PUBLIC_DIR=artifacts/smart-home/dist/public

# Optional HTTP → HTTPS redirect (usually handled by the reverse proxy).
# HTTP_REDIRECT_PORT=80

# Set to false only for local production testing over plain HTTP
# (otherwise the session cookie is marked Secure and WebSocket auth fails).
# COOKIE_SECURE=false

# Rate limiting (optional overrides)
# RATE_LIMIT_GLOBAL=1000
# RATE_LIMIT_WRITE=150
# RATE_LIMIT_READ=600
